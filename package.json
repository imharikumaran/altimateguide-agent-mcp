{
  "name": "altimateguide-agent-mcp",
  "version": "1.4.0",
  "description": "Altimateguide MCP server: an independent software directory (profiles, comparisons, alternatives, deals) plus agent-side tool submission for editorial review",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "llm",
    "agent",
    "claude",
    "cursor",
    "anthropic",
    "altimateguide",
    "directory",
    "tool-submission"
  ],
  "mcpName": "io.github.imharikumaran/altimateguide",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imharikumaran/altimateguide-agent-mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "bin": {
    "altimateguide-agent-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "node scripts/build-mcpb.mjs",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/index.js",
    "serve": "node dist/http.js",
    "check": "tsc --noEmit",
    "version": "node scripts/sync-version.mjs && git add server.json mcpb/manifest.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
