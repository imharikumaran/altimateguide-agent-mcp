# Altimateguide agent MCP — configuration
#
# An account API token. Optional to pre-set: you can instead run the
# complete_login tool (start_login -> read the email code -> complete_login)
# and the token is stored at ~/.config/altimateguide/credentials.json.
ALTIMATEGUIDE_AGENT_TOKEN=atg_...

# Override the API base (default https://altimateguide.com).
# ALTIMATEGUIDE_API_URL=https://altimateguide.com

# Where complete_login stores the token (default ~/.config/altimateguide).
# ALTIMATEGUIDE_CONFIG_DIR=/path/to/config
